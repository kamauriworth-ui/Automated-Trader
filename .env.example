# ---------------------------------------------------------------
# Copy this file to ".env" and fill in your values.
#   Mac/Linux:  cp .env.example .env
#   Windows:    copy .env.example .env
#
# .env is listed in .gitignore, so it will never be committed.
# NEVER put API keys directly in Python files.
# ---------------------------------------------------------------

# SAFETY SWITCH. Must be exactly TRUE or the app refuses to start.
# There is no "live" mode in this project.
PAPER_TRADING=TRUE

# Alpaca's PAPER trading endpoint. This is the only URL the app accepts.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Alpaca PAPER API keys.
# In GitHub Codespaces, leave these blank and add them as Codespaces secrets
# instead (see README). Values set that way override the blanks below.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
